# ==============================================================================
# SCENTPOD AI SHOPPING ASSISTANT - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU
# ==============================================================================
# Lưu ý: Không lưu khóa bí mật thực tế vào file này hoặc git repository.
# Sao chép file này thành .env để cấu hình local: cp .env.example .env

# 1. CẤU HÌNH SERVER CHÍNH
PORT=3000
NODE_ENV=development

# 2. LỰA CHỌN AI PROVIDER CHO BACKEND TRỢ LÝ MUA HÀNG
# Các giá trị hợp lệ: local | nvidia | openai | gemini
# - local: Bộ máy suy luận tư vấn mua hàng cục bộ (Offline/Zero latency, không cần API Key)
# - nvidia: Kết nối NVIDIA NIM / NVIDIA AI Blueprint microservice
# - openai: Kết nối OpenAI API (GPT-4o-mini / GPT-4o)
# - gemini: Kết nối Google Gemini API (Gemini 1.5 Flash)
AI_PROVIDER=local

# 3. CẤU HÌNH NVIDIA AI BLUEPRINT / NVIDIA NIM (Khi AI_PROVIDER=nvidia)
# Endpoint của NVIDIA Retail Shopping Assistant Orchestrator hoặc NVIDIA NIM:
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL_NAME=meta/llama-3.1-70b-instruct
# Nếu kết nối trực tiếp với microservice Catalog Retriever của Blueprint (mặc định port 8010):
NVIDIA_CATALOG_RETRIEVER_URL=http://localhost:8010

# 4. CẤU HÌNH OPENAI (Khi AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 5. CẤU HÌNH GEMINI (Khi AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 6. GIỚI HẠN TẦN SUẤT & BẢO VỆ (RATE LIMITING)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

